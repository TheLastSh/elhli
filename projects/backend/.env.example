PORT=3500
NODE_ENV=development
APP_NAME=educoro-ai-backend

MONGO_URI=mongodb://127.0.0.1:27017/educoro_ai
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS: deja sin valor en desarrollo (any) o define el origen de producción
CORS_ORIGIN=
# Directorio temporal para uploads (opcional; por defecto usa os.tmpdir())
UPLOAD_DIR=
