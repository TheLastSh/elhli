PORT=3500
NODE_ENV=development
APP_NAME=educoro-ai-backend

MONGO_URI=mongodb://127.0.0.1:27017/educoro_ai
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS: deja sin valor en desarrollo (any) o define el origen de producción
CORS_ORIGIN=
# Directorio temporal para uploads (opcional; por defecto usa os.tmpdir())
UPLOAD_DIR=

# Bot de Telegram (opcional): token del bot para consultas de notas/promedio y notificaciones
TELEGRAM_BOT_TOKEN=

# Rate limit de login (opcional; defaults: 5 intentos cada 900000 ms):
#LOGIN_RATE_MAX=5
#LOGIN_RATE_WINDOW_MS=900000
